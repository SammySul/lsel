# The palette as CSS custom properties, plus the type, spacing and shape every project shares.
p: ''
  /* Generated by lsel (theme/tokens.nix); change lsel, then `bun run sync` there. */
  @font-face {
    font-family: "JetBrains Mono";
    src: url("./JetBrainsMono-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "JetBrains Mono";
    src: url("./JetBrainsMono-Bold.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    color-scheme: dark;

    --base: ${p.base};
    --raise: ${p.raise};
    --surface: ${p.surface};
    --overlay: ${p.overlay};
    --highlight: ${p.highlight};
    --muted: ${p.muted};
    --subtle: ${p.subtle};
    --text: ${p.text};
    --accent: ${p.accent};
    --error: ${p.error};
    --warning: ${p.warning};
    --success: ${p.success};
    --select: ${p.select};
  ${builtins.concatStringsSep "\n" (
    builtins.genList (i: "  --term-${toString i}: ${builtins.elemAt p.term i};") 16
  )}

    --font: "JetBrains Mono", ui-monospace, monospace;
    --text-xs: 12px;
    --text-sm: 14px;
    --text-md: 16px;
    --text-lg: 20px;
    --text-xl: 28px;
    --leading: 1.5;

    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;

    --border: 1px solid var(--overlay);
    --focus: 2px solid var(--accent);
    --motion: 120ms ease-out;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    border-radius: 0;
  }

  html,
  body {
    margin: 0;
    background: var(--base);
    color: var(--text);
    font-family: var(--font);
    font-size: var(--text-sm);
    line-height: var(--leading);
  }

  :focus-visible {
    outline: var(--focus);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition-duration: 0s !important;
      animation-duration: 0s !important;
    }
  }
''
