# The palette as CSS custom properties, plus the type, spacing and shape every project shares.
p: ''
  /* Generated by lsel (theme/tokens.nix); change lsel, then `bun run sync` there. */
  @font-face {
    font-family: "JetBrains Mono";
    src: url("./JetBrainsMono-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "JetBrains Mono";
    src: url("./JetBrainsMono-Bold.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    color-scheme: dark;

    --base: ${p.base};
    --raise: ${p.raise};
    --surface: ${p.surface};
    --overlay: ${p.overlay};
    --highlight: ${p.highlight};
    --muted: ${p.muted};
    --subtle: ${p.subtle};
    --text: ${p.text};
    --accent: ${p.accent};
    --error: ${p.error};
    --warning: ${p.warning};
    --success: ${p.success};
    --select: ${p.select};
  ${builtins.concatStringsSep "\n" (
    builtins.genList (i: "  --term-${toString i}: ${builtins.elemAt p.term i};") 16
  )}

    --font: "JetBrains Mono", ui-monospace, monospace;
    --text-xs: 12px;
    --text-sm: 14px;
    --text-md: 16px;
    --text-lg: 20px;
    --text-xl: 28px;
    --text-display: 40px;
    --leading: 1.5;

    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 24px;
    --space-6: 32px;
    --space-7: 48px;

    --border: 1px solid var(--overlay);
    --focus: 2px solid var(--accent);
    --ease: cubic-bezier(0.2, 0, 0, 1);
    --motion-fast: 150ms;
    --motion: 200ms;
    --motion-slow: 300ms;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    border-radius: 0;
  }

  html,
  body {
    margin: 0;
    background: var(--base);
    color: var(--text);
    font-family: var(--font);
    font-size: var(--text-sm);
    line-height: var(--leading);
  }

  /* A page's content sits in main, in a thin frame; the app sets max-width and padding, never margin. */
  main {
    width: calc(100% - 2 * var(--space-5));
    margin: var(--space-5) auto;
    border: var(--border);
  }
  @media (max-width: 600px) {
    main {
      width: calc(100% - 2 * var(--space-2));
      margin: var(--space-2) auto;
    }
  }

  /* The common elements, styled once so every app looks the same; components may extend, not restyle. */
  h1,
  h2 {
    margin: 0;
    line-height: 1.2;
  }
  h1 {
    font-size: var(--text-xl);
  }
  h2 {
    font-size: var(--text-lg);
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }

  button,
  select,
  input:not([type="checkbox"], [type="radio"], [type="range"], [type="file"]),
  textarea {
    font: inherit;
    color: var(--text);
    background: var(--base);
    border: var(--border);
    padding: var(--space-1) var(--space-3);
  }
  button,
  select {
    cursor: pointer;
  }
  button:hover:not(:disabled),
  select:hover:not(:disabled) {
    border-color: var(--subtle);
  }
  button[aria-pressed="true"] {
    border-color: var(--accent);
  }
  button:disabled,
  select:disabled,
  input:disabled,
  textarea:disabled {
    color: var(--muted);
    cursor: default;
  }
  [aria-busy="true"],
  [aria-busy="true"]:disabled {
    cursor: progress;
  }
  input[aria-invalid="true"],
  select[aria-invalid="true"],
  select[aria-invalid="true"]:hover,
  textarea[aria-invalid="true"] {
    border-color: var(--error);
  }

  input[type="checkbox"],
  input[type="radio"],
  input[type="range"] {
    accent-color: var(--accent);
  }

  kbd {
    font-family: var(--font);
    font-size: var(--text-xs);
    color: var(--subtle);
    border: var(--border);
    border-bottom-width: 2px;
    padding: 0 var(--space-1);
  }

  pre,
  code {
    font-family: var(--font);
  }
  pre {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    background: var(--base);
    border: var(--border);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  table {
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--border);
    text-align: left;
  }
  th {
    color: var(--subtle);
    font-size: var(--text-xs);
    font-weight: 400;
  }

  :focus-visible {
    outline: var(--focus);
    outline-offset: 2px;
  }

  a,
  button,
  input,
  select,
  summary,
  textarea {
    transition:
      color var(--motion-fast) var(--ease),
      background-color var(--motion-fast) var(--ease),
      border-color var(--motion-fast) var(--ease),
      outline-color var(--motion-fast) var(--ease);
  }

  @keyframes lsel-appear {
    from {
      opacity: 0;
    }
  }

  /* Content that appears or swaps; re-key the element in Svelte to replay it. */
  .lsel-appear {
    animation: lsel-appear var(--motion) var(--ease) both;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      /* biome-ignore lint/complexity/noImportantStyles: the user's setting must beat every component's own transition */
      transition-duration: 0s !important;
      /* biome-ignore lint/complexity/noImportantStyles: the user's setting must beat every component's own animation */
      animation-duration: 0s !important;
    }
  }
''
