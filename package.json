{
  "name": "lsel",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "kit",
      "apps/*",
      "apps/yank-wars/apps/*",
      "apps/yank-wars/packages/*",
      "templates/web"
    ],
    "catalog": {
      "@codemirror/commands": "6.11.1",
      "@codemirror/language": "6.13.1",
      "@codemirror/search": "6.7.2",
      "@codemirror/state": "6.7.6",
      "@codemirror/view": "6.43.15",
      "@replit/codemirror-vim": "6.4.0",
      "@sveltejs/vite-plugin-svelte": "7.3.1",
      "@types/bun": "1.4.4",
      "playwright-core": "1.64.1",
      "svelte": "5.57.3",
      "svelte-check": "4.7.7",
      "typescript": "5.9.3",
      "valibot": "1.5.0",
      "vite": "8.3.5"
    }
  },
  "scripts": {
    "postinstall": "bun2nix -o bun.nix && bun kit/scripts/assets.ts",
    "check": "biome check . && bun run --filter ./kit --filter \"./apps/*\" --filter ./templates/web check",
    "test": "bun run --filter ./kit --filter \"./apps/*\" --filter ./templates/web test",
    "build": "bun run --filter ./kit --filter \"./apps/*\" --filter ./templates/web build",
    "test:e2e": "bun run --filter ./kit --filter \"./apps/*\" --filter ./templates/web test:e2e"
  },
  "patchedDependencies": {
    "@replit/codemirror-vim-core@0.1.0": "patches/@replit%2Fcodemirror-vim-core@0.1.0.patch"
  }
}
