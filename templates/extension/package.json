{
  "name": "project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --output human && biome check . && grep -q '\"preset\": \"recommended\"' biome.json",
