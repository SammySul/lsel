  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "1.4.4",
    "@types/chrome": "0.2.9",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-web-extension": "4.5.1"
  }
}
