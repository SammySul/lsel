{
  "name": "@sammysul/lsel",
  "version": "0.7.0",
  "private": true,
  "description": "lsel's look, components, keys, states, formats and server, shared by every app",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "lsel-check": "./src/lib/check.ts"
  },
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./server": "./src/lib/server/index.ts",
    "./server/accounts": "./src/lib/server/accounts.ts",
    "./server/board": "./src/lib/server/board.ts",
    "./server/fake-github": "./src/lib/server/fakeGitHub.ts",
    "./daily": "./src/lib/daily.ts",
    "./vite": "./src/lib/vite.ts",
    "./testing": "./src/lib/testing/index.ts",
    "./testing/preload": "./src/lib/testing/preload.ts",
    "./tokens.css": "./src/lib/assets/tokens.css",
    "./assets/*": "./src/lib/assets/*",
    "./tsconfig.json": "./config/tsconfig.json"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --output human",
    "test": "bun --conditions=browser test ./src",
    "test:e2e": "bun test ./e2e"
  },
  "dependencies": {
    "better-auth": "catalog:",
    "svelte": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/bun": "catalog:",
    "playwright-core": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
