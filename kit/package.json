{
  "name": "@sammysul/lsel",
  "version": "0.5.3",
  "description": "lsel's look, components, keys, states, formats and server, shared by every project",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.fixture.*",
    "config"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "lsel-check": "./dist/check.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/preload": "./dist/testing/preload.js",
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./tokens.css": "./dist/assets/tokens.css",
    "./assets/*": "./dist/assets/*",
    "./biome": "./config/biome.json",
    "./tsconfig.json": "./config/tsconfig.json"
  },
  "scripts": {
    "assets": "bun scripts/assets.ts",
    "dev": "bun run assets && bun --bun vite",
    "package": "bun run assets && svelte-package -i src/lib -o dist",
    "build": "bun run assets && bun --bun vite build",
    "check": "bun run assets && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --output human && biome check .",
    "test": "bun --conditions=browser test ./src",
    "test:e2e": "bun test ./e2e",
    "prepack": "bun run package"
  },
  "peerDependencies": {
    "playwright-core": "^1.64.0",
    "svelte": "^5.57.0",
    "valibot": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/package": "3.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "1.4.4",
    "playwright-core": "1.64.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "valibot": "1.5.0",
    "vite": "8.3.5"
  }
}
