{
  "name": "yank-wars",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@codemirror/commands": "6.11.1",
      "@codemirror/language": "6.13.1",
      "@codemirror/search": "6.7.2",
      "@codemirror/state": "6.7.6",
      "@codemirror/view": "6.43.15",
      "@replit/codemirror-vim": "6.4.0",
      "typescript": "5.9.3"
    }
  },
  "scripts": {
    "dev": "bun run --filter @yank-wars/web dev",
    "build": "bun run --filter @yank-wars/web build",
    "check": "tsc --noEmit -p packages/engine && tsc --noEmit -p apps/server && bun run --filter @yank-wars/web check && biome check . && lsel-check",
    "test": "bun --conditions=browser test",
    "test:e2e": "bun test ./apps/web/e2e/flow.e2e.ts ./apps/web/e2e/parity.e2e.ts ./apps/web/e2e/built.e2e.ts",
    "oracle": "bun packages/engine/oracle/run.ts",
    "test:browser": "bun apps/web/browser/run.ts",
    "postinstall": "bun2nix -o bun.nix",
    "brand": "bun apps/web/brand/render.ts"
  },
  "devDependencies": {
    "@sammysul/lsel": "0.5.1",
    "@types/bun": "1.4.4",
    "happy-dom": "21.0.4",
    "playwright-core": "1.64.1",
    "typescript": "catalog:"
  },
  "patchedDependencies": {
    "@replit/codemirror-vim-core@0.1.0": "patches/@replit%2Fcodemirror-vim-core@0.1.0.patch"
  }
}
