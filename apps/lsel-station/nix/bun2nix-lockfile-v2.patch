nix-community/bun2nix PR #110 (Mic92): accept lockfileVersion 2 and 3.
bun >= 1.3 writes 2; the packages layout bun2nix reads is unchanged.
Drop once a release contains it.

--- a/src/lib.rs
+++ b/src/lib.rs
@@ -26,7 +26,9 @@
 pub fn convert_lockfile_to_nix_expression(contents: String, options: Options) -> Result<String> {
     let lockfile = contents.parse::<Lockfile>()?;
 
-    if lockfile.lockfile_version != 1 {
+    // v2 only tightened bun's own parsing and v3 only extends `overrides`
+    // values, which are not read here; the `packages` layout is unchanged.
+    if !(1..=3).contains(&lockfile.lockfile_version) {
         return Err(Error::UnsupportedLockfileVersion(lockfile.lockfile_version));
     };
 
